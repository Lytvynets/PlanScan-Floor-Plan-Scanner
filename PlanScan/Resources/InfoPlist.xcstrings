    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PlanScan uses the camera and LiDAR sensor to scan rooms. Scans are processed on your device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PlanScan використовує камеру й сенсор LiDAR для сканування кімнат. Скани обробляються на вашому пристрої."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you save floor plan images to your photo library."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дає змогу зберігати зображення планів у вашій медіатеці."
          }
        }
      }
    }
  },
  "version": "1.0"
